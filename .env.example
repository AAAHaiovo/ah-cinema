# AH 影视服务端环境变量示例（不要提交真实值）
# 生产环境缺少 AH_API_TOKEN 或 AH_SIGNING_SECRET 时，受保护接口会返回 503。
# Vercel 与腾讯云 EdgeOne Pages 通用；平台控制台里逐条添加即可。
# EdgeOne 必填：AH_ENV=production、AH_API_TOKEN、AH_SIGNING_SECRET。

AH_ENV=production

# App 里要填的“访问口令”。生成：
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AH_API_TOKEN=

# 代理签名密钥，只放在服务端，不要填进 App。
AH_SIGNING_SECRET=

# 允许跨域调用 API 的额外来源（GitHub Pages 默认已包含）
# AH_ALLOWED_ORIGINS=https://example.com

# 可选调优
# AH_SEARCH_MAX_PAGES=2
# AH_PROXY_TTL_SECONDS=43200
# 代理单次响应上限（字节）。Vercel 可用默认 20971520；
# EdgeOne 免费版单次响应上限 6 MB，建议 5500000 留余量。
# AH_PROXY_MAX_BYTES=20971520

# 仅本地开发：只对 loopback 生效，绝不要在生产环境设置
# AH_DEV_NO_AUTH=1
# AH_DEV_ALLOW_PRIVATE=1
